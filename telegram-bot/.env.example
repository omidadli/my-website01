# ====== ربات تلگرام امید عدلی — نمونه پیکربندی ======
# این فایل را کپی کنید به: telegram-bot/.env   (و .env را هرگز کامیت نکنید)

# توکن ربات از @BotFather -> /newbot  (یا /token)
# ⚠️ توکن را در چت/گیت‌هاب هرگز نفرستید؛ فقط در همین فایل محلی بگذارید.
BOT_TOKEN=

# آیدی عددی ادمین(ها) — با ربات @userinfobot قابل دریافت است. چند نفر با کاما
ADMIN_TG_IDS=123456789

# رمز مشترک پل ارتباطی سایت ↔ ربات (هدر X-Bot-Webhook-Secret)
# یک رشته تصادفی قوی بسازید:  openssl rand -hex 32
WEBHOOK_SECRET=

# حالت دریافت آپدیت: polling (پیش‌فرض، بدون دامنه) یا webhook (نیاز به HTTPS عمومی)
BOT_MODE=polling

# فقط برای حالت webhook — آدرس عمومی HTTPS سرور ربات
# PUBLIC_URL=https://bot.example.com

# پورت HTTP داخلی (health + پل سایت + webhook)
BOT_PORT=8787

# پوشه ذخیره‌سازی داده‌ها (پیش‌فرض: telegram-bot/data)
# DATA_DIR=data

# آیدی/آدرس پشتیبانی که به کاربران نمایش داده می‌شود
SUPPORT_HANDLE=@omidadli

# آدرس سایت
SITE_URL=https://omidadli.com

# حداکثر پیام هر کاربر در دقیقه
RATE_LIMIT_PER_MINUTE=20
