# Copy to .env (or set these in your MCP client config) and fill in real values.
# The MCP server reads these to reach and authenticate with your site.

# Base URL of the site (no trailing slash).
#   local dev:  http://localhost:3000
#   production: https://omidadli.site  (or your custom domain)
SITE_URL=https://omidadli.site

# Admin credentials — the SAME values as your Cloudflare Pages secrets
# ADMIN_USERNAME / ADMIN_PASSWORD.
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-admin-password
