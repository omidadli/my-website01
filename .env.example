# GEMINI_API_KEY (optional): last-resort fallback key for every AI section.
# The recommended setup is 5 keys per section, entered in the admin panel
# («کلیدهای API») and stored server-side (D1.ai_section_keys). See docs/API-KEYS.md.
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Cloudflare Pages / Telegram Bot / Self-Hosted Card-to-Card Gateway ---
# Site base URL used for payment pages (/pay/:id) and Telegram deep links
SITE_URL="https://omidadli.site"

# Telegram Bot configuration (Pages Secrets)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""
TELEGRAM_ADMIN_IDS=""
SUPPORT_HANDLE="@omidadli"

# Fallback destination card if no card has been added in /admin -> درگاه کارت‌به‌کارت خودکار yet
BOT_CARD_NUMBER=""
BOT_CARD_HOLDER="امید عدلی"

# Optional strict mode: set to "true" to pause checkout if Android SMS Uploader heartbeat is older than 10 minutes
PAYMENT_REQUIRE_ONLINE_DEVICE="false"

